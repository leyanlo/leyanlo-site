{
  "name": "leyanlo-site",
  "description": "Leyan Lo’s website",
  "version": "1.0.0",
  "author": "Leyan Lo <leyanlo@gmail.com>",
  "dependencies": {
    "babel-plugin-styled-components": "^1.10.0",
    "core-js": "^2.6.2",
    "fontfaceobserver": "^2.1.0",
    "gatsby": "5.16.1",
    "gatsby-cli": "5.16.0",
    "gatsby-image": "3.11.0",
    "gatsby-plugin-google-analytics": "5.16.0",
    "gatsby-plugin-manifest": "5.16.0",
    "gatsby-plugin-offline": "6.16.0",
    "gatsby-plugin-react-helmet": "6.16.0",
    "gatsby-plugin-sharp": "5.16.0",
    "gatsby-plugin-styled-components": "6.16.0",
    "gatsby-source-filesystem": "5.16.0",
    "gatsby-transformer-sharp": "5.16.0",
    "normalize.css": "^8.0.1",
    "prop-types": "^15.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet": "^5.2.0",
    "react-string-replace-recursively": "^0.1.27",
    "styled-components": "5.3.11",
    "typeface-source-sans-pro": "0.0.54",
    "typeface-source-serif-pro": "0.0.54",
    "@gatsbyjs/reach-router": "2.0.1"
  },
  "keywords": [
    "leyanlo"
  ],
  "license": "MIT",
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "format": "npm-run-all -p format:js format:css",
    "format:js": "prettier --write 'src/**/*.{js,jsx,json,yaml}'",
    "format:css": "prettier --write 'src/**/*.css'",
    "lint": "npm-run-all -p lint:js lint:css lint:css-js",
    "lint:js": "eslint --fix --ignore-path .gitignore 'src/**/*.{js,jsx}'",
    "lint:css": "stylelint --fix 'src/**/*.css'",
    "lint:css-js": "stylelint --config stylelint-js.config.js 'src/**/*.{js,jsx}'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-constant-elements": "^7.2.0",
    "eslint": "^5.12.1",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^3.6.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.1",
    "eslint-plugin-prettier": "^2.6.2",
    "eslint-plugin-react": "^7.12.4",
    "eslint-plugin-sort-imports-es6-autofix": "^0.3.0",
    "gatsby-plugin-react-svg": "3.3.0",
    "husky": "^1.3.1",
    "lint-staged": "^7.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^1.15.3",
    "stylelint": "^9.10.1",
    "stylelint-config-prettier": "^4.0.0",
    "stylelint-config-rational-order": "0.0.2",
    "stylelint-config-standard": "^18.2.0",
    "stylelint-config-styled-components": "^0.1.1",
    "stylelint-processor-styled-components": "^1.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leyanlo/leyanlo-site"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{json,yaml}": [
      "prettier --write",
      "git add"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "stylelint --config stylelint-js.config.js",
      "git add"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix",
      "git add"
    ]
  },
  "overrides": {
    "sharp": "0.35.5",
    "loader-utils@^1": "1.4.2",
    "loader-utils@^2": "2.0.4",
    "lodash@^4": "4.18.1",
    "flatted@^3": "3.4.4",
    "immutable@^3": "3.8.4",
    "immutable@^4": "4.3.9",
    "json5@^1": "1.0.2",
    "cross-spawn@^6": "6.0.6",
    "postcss@^8": "8.5.31",
    "tmp": "0.2.7",
    "trim@0.0.x": "0.0.3",
    "trim-newlines@^3": "3.0.1"
  }
}
